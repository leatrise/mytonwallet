# Install as /opt/yohi/secrets/backend.env with mode 0600. Never commit real keys.
ALLOWED_ORIGINS=https://yohi.io,capacitor://localhost,http://localhost
UPSTREAM_TIMEOUT_MS=8000

TONCENTER_MAINNET_URL=https://toncenter.com
TONCENTER_MAINNET_API_KEY=
TONCENTER_MAINNET_SECONDARY_URL=
TONCENTER_MAINNET_SECONDARY_API_KEY=
TONCENTER_TESTNET_URL=https://testnet.toncenter.com
TONCENTER_TESTNET_API_KEY=
TONCENTER_TESTNET_SECONDARY_URL=
TONCENTER_TESTNET_SECONDARY_API_KEY=

TONAPI_MAINNET_URL=https://tonapi.io
TONAPI_MAINNET_API_KEY=
TONAPI_MAINNET_SECONDARY_URL=
TONAPI_MAINNET_SECONDARY_API_KEY=
