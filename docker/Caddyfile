{
	auto_https off
	servers {
		protocols h1 h2
		timeouts {
			read_body 15s
			read_header 10s
			write 30s
			idle 2m
		}
	}
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	request_body {
		max_size 64KB
	}

	route {
		@walletTos {
			host wallet.yohi.io
			path /tos
		}
		handle @walletTos {
			reverse_proxy terms-of-use:80
		}

		@walletTosSlash {
			host wallet.yohi.io
			path /tos/
		}
		handle @walletTosSlash {
			redir /tos 308
		}

		@walletHost host wallet.yohi.io
		handle @walletHost {
			respond 404
		}

		handle /bridge/* {
			reverse_proxy ton-connect-bridge:8081 {
				flush_interval -1
			}
		}

		handle {
			reverse_proxy backend-api:3000 {
				flush_interval -1
			}
		}
	}

	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
				request>remote_ip ip_mask 24 56
			}
		}
	}
}
