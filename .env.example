# Yohi Wallet launch profile: TON core without background notification services.
NO_TON=0
NO_TRON=1
NO_SOLANA=1
NO_EVM=1
NO_WALLETCONNECT=1
NO_SWAP=1
NO_STAKING=1
NO_PORTFOLIO=1
NO_MFA=1
NO_AGENT=1
NO_LEDGER=0
NO_NOTIFICATIONS=1
NO_ACCOUNT_CONFIG=1
